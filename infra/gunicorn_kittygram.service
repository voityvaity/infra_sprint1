[Unit]
Description=Gunicorn service for Kittygram
After=network.target

[Service]
User=yc-user
WorkingDirectory=/home/yc-user/infra_sprint1/backend
ExecStart=/home/yc-user/infra_sprint1/backend/venv/bin/gunicorn \
    --bind 0.0.0.0:8080 \
    kittygram_backend.wsgi
EnvironmentFile=/home/yc-user/infra_sprint1/backend/.env
Restart=on-failure

[Install]
WantedBy=multi-user.target

